# Kephra Environment Configuration Example
# Copy this file to .env and fill in your actual values

# GitHub Configuration
GITHUB_TOKEN=your_github_token_here
GITHUB_USERNAME=your_github_username

# System Settings
AUTONOMOUS_MODE=true
ISSUE_POLLING_INTERVAL=60  # Check every minute
LOG_LEVEL=INFO

# Ethereum Node Settings
ETH_NODE_URL=https://mainnet.infura.io/v3/your_infura_project_id
ETH_ARCHIVE_NODE_URL=https://eth-archival.example.com

# Agent Configuration
PROPOSER_AGENT_ENABLED=true
REVIEWER_AGENT_ENABLED=true
SIMULATOR_AGENT_ENABLED=true
CONSENSUS_AGENT_ENABLED=true

# Dashboard Settings
DASHBOARD_PORT=8000
OPEN_BROWSER_ON_START=true

# API Keys for different LLM providers
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Configuration
ENVIRONMENT=development # development, staging, production

# Agent settings
DEFAULT_AGENT_MODEL=gpt-4o # Default model to use for agents
MAX_TOKENS=8192 # Maximum tokens to use in requests
TEMPERATURE=0.2 # Default temperature for agent responses

# MCP (Model Context Protocol) Configuration
MCP_ENABLED=true
MCP_PORT=8080
MCP_HOST=localhost
MCP_TRANSPORT_TYPE=stdio # stdio or http
MCP_SERVER_PATH=/path/to/mcp/server/executable # Path to MCP server executable
MCP_REGISTRY_URL= # URL for MCP registry when available
MCP_SERVERS_DIR=./mcp_servers # Directory for local MCP servers

# Database Configuration
DATABASE_URL=sqlite:///kephra.db

# Ethereum Node Connection (for testing and simulation)
# Leave blank to use a local simulated environment
ETH_CHAIN_ID=1 # Mainnet is 1, Goerli is 5, etc.

# ChaosChain Configuration (for integration testing)
CHAOSCHAIN_NODE_URL=http://localhost:26657
CHAOSCHAIN_API_URL=http://localhost:1317 